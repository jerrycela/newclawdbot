# Clawdbot Configuration
# Copy this file to .env and fill in your values

# === Telegram ===
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the bot
# Leave empty to allow all users (not recommended for production)
TELEGRAM_ALLOWED_USERS=123456789,987654321

# === Claude Code ===
# Session ID prefix for Claude Code sessions
CLAUDE_SESSION_PREFIX=clawdbot

# Maximum conversation turns before session rotation
CLAUDE_MAX_TURNS=50

# Timeout for Claude Code responses in milliseconds
CLAUDE_TIMEOUT_MS=120000

# === Supabase (Optional - for memory persistence) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_key

# === OpenAI (Optional - for embeddings) ===
OPENAI_API_KEY=sk-your_api_key

# === Server ===
# Port for the API server
API_PORT=8080

# Port for the Dashboard (if running separately)
DASHBOARD_PORT=3000

# WebSocket heartbeat interval in milliseconds
WS_HEARTBEAT_INTERVAL=30000

# === Security ===
# Secret key for API authentication (min 16 characters)
# Leave empty to disable authentication (not recommended)
API_SECRET=your_secret_key_min_16_chars

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# === Monitoring ===
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Admin Telegram chat ID for alerts (optional)
TELEGRAM_ADMIN_CHAT_ID=

# === Environment ===
NODE_ENV=development
