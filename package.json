{
  "name": "clawdbot",
  "version": "1.0.0",
  "description": "AI assistant powered by Claude Code with Telegram integration and Dashboard",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "dev:dashboard": "cd src/dashboard/web && npm run dev",
    "dev:all": "bun run dev & bun run dev:dashboard",
    "start": "bun run src/index.ts",
    "start:dashboard": "cd src/dashboard/web && npm run start",
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:dashboard": "cd src/dashboard/web && npm run build",
    "build:all": "bun run build && bun run build:dashboard",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "bunx @biomejs/biome check src/ --ignore-pattern=src/dashboard/web",
    "lint:fix": "bunx @biomejs/biome check --write src/ --ignore-pattern=src/dashboard/web",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.94.1",
    "grammy": "^1.39.3",
    "hono": "^4.11.7",
    "lru-cache": "^11.2.5",
    "openai": "^6.17.0",
    "pino": "^10.3.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  }
}
